# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
kubeconfig
*.kubeconfig

# --- Python ---
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
.venv-*/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Frontend (Phase 5) ---
node_modules/
.vite/
*.local

# --- Helm: vendored subcharts, rebuilt from the committed Chart.lock ---
deploy/helm/*/charts/

# --- Structurizr Lite runtime artifacts ---
docs/architecture/.structurizr/
docs/architecture/workspace.json

# --- Data and model artifacts: too large for git ---
data/
models/
*.gguf
*.safetensors
*.parquet
*.duckdb

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Editors ---
.idea/
*.swp
